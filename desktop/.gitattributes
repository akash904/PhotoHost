# Normalise to LF in the repository; check out native on Windows. Same rules as gpicAlter, so the
# exported Room schemas compare byte-for-byte across the two repos once committed.
* text=auto

# gradlew is executed by /bin/sh. With CRLF endings it fails on Linux and macOS with a confusing
# "bad interpreter" error, so it is pinned regardless of the checkout platform.
gradlew text eol=lf
*.sh text eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf

# Never touched, never diffed as text.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.heic binary
*.mp4 binary
*.mov binary
*.webp binary
