<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (MSIX). Built by `gradlew packageMsix`, which fills in @VERSION@ and
  lays the jpackage app image out under PhotoHost\ next to the generated Assets\.

  Identity is the product reserved in Partner Center; the Store re-signs the package with that
  publisher's certificate, so it is uploaded unsigned.

  Three things differ from the setup .exe, each because a package works differently (see Packaged.kt):
    - Start at sign-in is the StartupTask below, off until the user switches it on in
      Settings > Apps > Startup. It runs PhotoHostAtSignIn.exe, the same app started in the tray
      (see at-sign-in.properties), because a StartupTask cannot pass arguments.
      (No double hyphens in this comment: XML forbids them, and makepri rejects the file.)
    - The firewall rule is declared here and added at install, for both executables, TCP only, all
      network types (Tailscale counts as public).
    - The data folder (%LOCALAPPDATA%\PhotoHost) is redirected into the package and removed on
      uninstall. The library folder is outside AppData and stays.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop2 rescap">

  <Identity
    Name="AkashVerma.PhotoHost"
    Publisher="CN=F295E1DD-979A-41E8-8655-40F7F7DF02F5"
    Version="@VERSION@.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PhotoHost</DisplayName>
    <PublisherDisplayName>Akash Verma</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="PhotoHost" Executable="PhotoHost\PhotoHost.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PhotoHost"
        Description="Photo library server for the PhotoHost phone app"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension
          Category="windows.startupTask"
          Executable="PhotoHost\PhotoHostAtSignIn.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="PhotoHostAtSignIn" Enabled="false" DisplayName="PhotoHost" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Extensions>
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="PhotoHost\PhotoHost.exe">
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="all" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="PhotoHost\PhotoHostAtSignIn.exe">
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="all" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
