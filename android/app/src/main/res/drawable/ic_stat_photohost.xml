<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon. The system draws these as a flat white silhouette on a 24dp canvas and discards
  any colour, so this is the launcher mark with everything that would not survive that stripped out:
  no gradients, no six blades (they close to a smudge at 24dp), and a solid centre instead of a lit
  one. Roof, barrel, opening: the three shapes that still read at a glance in a status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <path
        android:pathData="M12,2.5 L21.5,11 L18.5,11 L12,5.2 L5.5,11 L2.5,11 Z"
        android:fillColor="#FFFFFFFF" />

    <path
        android:pathData="M7,16 A5,5 0 0 1 17,16 A5,5 0 0 1 7,16 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />

    <path
        android:pathData="M12,14.2 A1.8,1.8 0 0 1 12,17.8 A1.8,1.8 0 0 1 12,14.2 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
