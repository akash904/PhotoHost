<?xml version="1.0" encoding="utf-8"?>
<!--
  Status bar icon, drawn flat white on a 24dp canvas with every colour discarded.

  Six separate blades cannot survive here: the gaps that divide them would be under a pixel. So the
  blades merge into the one thing they collectively are, a lens with a hexagonal opening, cut out
  with fillType evenOdd so the opening is a real hole and reads at this size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <path
        android:fillType="evenOdd"
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3 A9,9 0 0 1 12,21 A9,9 0 0 1 12,3 Z M12,7.96 L15.5,10 L15.5,14 L12,16.04 L8.5,14 L8.5,10 Z" />
</vector>
