<?xml version="1.0" encoding="utf-8"?>
<!--
  Status bar icon. The system draws these as a flat white silhouette on a 24dp canvas and throws
  every colour away, so this is the launcher mark reduced to what still reads at that size: two
  broadcast arcs instead of three, one card instead of two, and a horizon with no sun. The card
  behind and the sun are the first things to become noise at 24dp, so they are the first to go.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <path
        android:pathData="M8.97,9.25 A3.5,3.5 0 0 1 15.03,9.25 M6.8,8 A6,6 0 0 1 17.2,8"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <path
        android:fillType="evenOdd"
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.5,12.5 L18.5,12.5 A1.5,1.5 0 0 1 20,14 L20,19.5 A1.5,1.5 0 0 1 18.5,21 L5.5,21 A1.5,1.5 0 0 1 4,19.5 L4,14 A1.5,1.5 0 0 1 5.5,12.5 Z M5.6,19.9 L9.4,15.6 L11.9,18.3 L14,16.2 L18.4,19.9 Z" />
