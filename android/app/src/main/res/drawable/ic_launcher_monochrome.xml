<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed icon layer (Android 13+), where the launcher discards every colour and re-tints the shape
  to the wallpaper.

  Colour is what separates the three prints in the real icon, and colour is exactly what this layer
  loses. So the two behind become outlines and only the front one stays solid, which keeps the fan
  readable as three objects in a single tint. The sun and hills are cut out with fillType evenOdd
  rather than painted, because a painted shape in the same tint as its surroundings is invisible
  while a hole stays a hole.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FF000000">

    <group android:pivotX="54" android:pivotY="58" android:rotation="-15">
        <path
            android:pathData="M41,36 L67,36 A7,7 0 0 1 74,43 L74,69 A7,7 0 0 1 67,76 L41,76 A7,7 0 0 1 34,69 L34,43 A7,7 0 0 1 41,36 Z"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="4" />
    </group>

    <group android:pivotX="54" android:pivotY="58" android:rotation="15">
        <path
            android:pathData="M41,36 L67,36 A7,7 0 0 1 74,43 L74,69 A7,7 0 0 1 67,76 L41,76 A7,7 0 0 1 34,69 L34,43 A7,7 0 0 1 41,36 Z"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="4" />
    </group>

    <path
        android:fillType="evenOdd"
        android:fillColor="#FF000000"
        android:pathData="M41,36 L67,36 A7,7 0 0 1 74,43 L74,69 A7,7 0 0 1 67,76 L41,76 A7,7 0 0 1 34,69 L34,43 A7,7 0 0 1 41,36 Z M62,42 A5,5 0 0 1 62,52 A5,5 0 0 1 62,42 Z M37,72 L46,59 L54,68 L60,62 L71,72 Z" />
</vector>
