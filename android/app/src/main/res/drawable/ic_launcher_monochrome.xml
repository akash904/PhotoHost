<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer (Android 13+), where the launcher throws away these colours and re-tints the
  shape to match the wallpaper. So this is the same mark drawn as a flat silhouette: no gradients,
  which would be discarded anyway, and heavier strokes, because a tinted icon is often rendered
  low-contrast against its own background and hairlines simply disappear there.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FF000000">

    <path
        android:pathData="M54,20 L86,50 L77,50 L54,28 L31,50 L22,50 Z"
        android:fillColor="#FF000000" />

    <path
        android:pathData="M38,70 A16,16 0 0 1 70,70 A16,16 0 0 1 38,70 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,63.5 L54,56.5 M48.37,66.75 L42.31,63.25 M48.37,73.25 L42.31,76.75 M54,76.5 L54,83.5 M59.63,73.25 L65.69,76.75 M59.63,66.75 L65.69,63.25"
        android:strokeColor="#FF000000"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,63.5 L59.63,66.75 L59.63,73.25 L54,76.5 L48.37,73.25 L48.37,66.75 Z"
        android:fillColor="#FF000000" />
</vector>
