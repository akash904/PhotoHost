<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed icon layer (Android 13+), where the launcher discards every colour and tints the whole
  shape to the wallpaper.

  Hue is the only thing separating the six blades in the real icon, and hue is exactly what this
  layer takes away. A white stroke cannot help here either, since white becomes the same tint as
  everything else. So the gap has to become geometry: each blade narrows from 52 degrees to 48, and
  the 12 degree space left between them is real empty canvas that survives any tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FF000000">

    <group android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path android:pathData="M64,49.8 L80.49,42.21 A29,29 0 0 1 80.49,65.79 L64,58.2 Z"
            android:fillColor="#FF000000" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="60">
        <path android:pathData="M64,49.8 L80.49,42.21 A29,29 0 0 1 80.49,65.79 L64,58.2 Z"
            android:fillColor="#FF000000" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="120">
        <path android:pathData="M64,49.8 L80.49,42.21 A29,29 0 0 1 80.49,65.79 L64,58.2 Z"
            android:fillColor="#FF000000" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path android:pathData="M64,49.8 L80.49,42.21 A29,29 0 0 1 80.49,65.79 L64,58.2 Z"
            android:fillColor="#FF000000" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="240">
        <path android:pathData="M64,49.8 L80.49,42.21 A29,29 0 0 1 80.49,65.79 L64,58.2 Z"
            android:fillColor="#FF000000" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="300">
        <path android:pathData="M64,49.8 L80.49,42.21 A29,29 0 0 1 80.49,65.79 L64,58.2 Z"
            android:fillColor="#FF000000" />
    </group>
</vector>
