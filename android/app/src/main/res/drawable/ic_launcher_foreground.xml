<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a roof over a lit aperture.

  The whole mark sits inside the 72dp safe zone (x 22..86, y 20..86 of a 108 viewport), because a
  circular mask keeps only the middle 66dp and anything drawn wider gets sliced off on exactly the
  launchers most people use.

  A six-bladed iris rather than a plain ring, so the shape reads as a camera and not as a generic
  target, with the opening lit from within. Roof over aperture is the whole idea of the app in one
  mark: photographs, hosted at home, lit up and reachable from far away.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Roof. Brighter at the apex so it catches the light rising off the aperture below. -->
    <path android:pathData="M54,20 L86,50 L77,50 L54,28 L31,50 L22,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="20"
                android:endX="54" android:endY="50">
                <item android:offset="0.0" android:color="#FFB6E2FF" />
                <item android:offset="1.0" android:color="#FF6FBEF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Aperture barrel. -->
    <path
        android:pathData="M38,70 A16,16 0 0 1 70,70 A16,16 0 0 1 38,70 Z"
        android:fillColor="#00000000"
        android:strokeColor="@color/photohost_accent"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Six blades. Thin on purpose: they carry the "camera" reading at full size and dissolve
         gracefully into the ring at launcher size rather than turning into mud. -->
    <path
        android:pathData="M54,63.5 L54,56.5 M48.37,66.75 L42.31,63.25 M48.37,73.25 L42.31,76.75 M54,76.5 L54,83.5 M59.63,73.25 L65.69,76.75 M59.63,66.75 L65.69,63.25"
        android:strokeColor="@color/photohost_accent"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- The opening, lit. -->
    <path android:pathData="M54,63.5 L59.63,66.75 L59.63,73.25 L54,76.5 L48.37,73.25 L48.37,66.75 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="70"
                android:gradientRadius="8">
                <item android:offset="0.0" android:color="#FFF2F9FF" />
                <item android:offset="1.0" android:color="#FF8FD1FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
