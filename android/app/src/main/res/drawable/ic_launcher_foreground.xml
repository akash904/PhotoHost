<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: a photo, with another behind it, being broadcast.

  Two cards rather than one, because the app serves a library and not a picture. The card behind is
  an outline while the card in front is solid, which is what keeps them legible as two objects once
  the icon is flattened to a single tint for a themed icon, where a lighter shade would simply
  disappear.

  The horizon and sun are knocked out of the front card with fillType="evenOdd" rather than painted
  over it in the background colour. Painted shapes vanish the moment the launcher re tints the
  silhouette; real holes survive, because a hole is a hole in any colour.

  Everything lives inside a circle of radius 33 around the centre, not merely inside the 72dp safe
  square. A circular mask keeps only that circle, so a mark that fills the safe square corner to
  corner gets its corners sliced off on most launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Broadcast. Three arcs on one centre, heavy enough to hold at launcher size. -->
    <path
        android:pathData="M48.8,40 A6,6 0 0 1 59.2,40 M43.6,37 A12,12 0 0 1 64.4,37 M38.4,34 A18,18 0 0 1 69.6,34"
        android:fillColor="#00000000"
        android:strokeColor="@color/photohost_accent"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- The library behind the picture. -->
    <path
        android:pathData="M47,45 L73,45 A4,4 0 0 1 77,49 L77,65 A4,4 0 0 1 73,69 L47,69 A4,4 0 0 1 43,65 L43,49 A4,4 0 0 1 47,45 Z"
        android:fillColor="#00000000"
        android:strokeColor="@color/photohost_accent_dim"
        android:strokeWidth="3.5" />

    <!-- Front card, with the horizon and sun cut out of it. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M37,53 L63,53 A4,4 0 0 1 67,57 L67,73 A4,4 0 0 1 63,77 L37,77 A4,4 0 0 1 33,73 L33,57 A4,4 0 0 1 37,53 Z M35,75 L45,61 L53,69 L59,64 L65,75 Z M61,56.2 A2.8,2.8 0 0 1 61,61.8 A2.8,2.8 0 0 1 61,56.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33" android:startY="53"
                android:endX="67" android:endY="77">
                <item android:offset="0.0" android:color="#FFB6E2FF" />
                <item android:offset="1.0" android:color="#FF6FBEF8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
