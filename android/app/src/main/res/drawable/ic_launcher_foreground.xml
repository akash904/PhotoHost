<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: a camera aperture, one colour per blade.

  Colour first, on white, because that is what the icon has to be. It stays a lens rather than pure
  decoration, so it still says "pictures" to somebody who has never opened the app, but nothing in
  it describes how the app works.

  One blade is drawn once and rotated six times about the centre. All six are identical, so the
  shape is defined in a single place and the arithmetic cannot drift between them.

  Each blade spans 52 degrees at 60 degree spacing, leaving an 8 degree gap. The white stroke sits
  in that gap: the separation between blades is a real drawn thing, not an absence, which is what
  makes six shapes still read as six once the icon is 48dp wide.

  Everything sits within radius 29 of the centre, inside the 66dp circle a round mask keeps. The
  blades meet a hexagonal opening in the middle, which is where the white background shows through.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path
            android:pathData="M64,49.5 L80.07,41.29 A29,29 0 0 1 80.07,66.71 L64,58.5 Z"
            android:fillColor="@color/blade_orange"
            android:strokeColor="@color/blade_gap"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round" />
    </group>

    <group android:pivotX="54" android:pivotY="54" android:rotation="60">
        <path
            android:pathData="M64,49.5 L80.07,41.29 A29,29 0 0 1 80.07,66.71 L64,58.5 Z"
            android:fillColor="@color/blade_yellow"
            android:strokeColor="@color/blade_gap"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round" />
    </group>

    <group android:pivotX="54" android:pivotY="54" android:rotation="120">
        <path
            android:pathData="M64,49.5 L80.07,41.29 A29,29 0 0 1 80.07,66.71 L64,58.5 Z"
            android:fillColor="@color/blade_green"
            android:strokeColor="@color/blade_gap"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round" />
    </group>

    <group android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path
            android:pathData="M64,49.5 L80.07,41.29 A29,29 0 0 1 80.07,66.71 L64,58.5 Z"
            android:fillColor="@color/blade_blue"
            android:strokeColor="@color/blade_gap"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round" />
    </group>

    <group android:pivotX="54" android:pivotY="54" android:rotation="240">
        <path
            android:pathData="M64,49.5 L80.07,41.29 A29,29 0 0 1 80.07,66.71 L64,58.5 Z"
            android:fillColor="@color/blade_violet"
            android:strokeColor="@color/blade_gap"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round" />
    </group>

    <group android:pivotX="54" android:pivotY="54" android:rotation="300">
        <path
            android:pathData="M64,49.5 L80.07,41.29 A29,29 0 0 1 80.07,66.71 L64,58.5 Z"
            android:fillColor="@color/blade_coral"
            android:strokeColor="@color/blade_gap"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round" />
    </group>
</vector>
