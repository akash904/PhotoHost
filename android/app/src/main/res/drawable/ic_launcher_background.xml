<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: near white, with a barely there lift towards the middle.

  Light rather than the app's charcoal. On a launcher the icon sits among dozens of others, most of
  them bright, and a dark tile reads as a system utility rather than as somewhere photographs live.
  The lift is very slight, just enough that the layer is not a flat rectangle when the launcher
  shifts it under parallax.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="76">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.65" android:color="#FFFBFCFE" />
                <item android:offset="1.0" android:color="#FFEDF1F6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
