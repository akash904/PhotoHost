<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background.

  A radial lift rather than a flat fill: the launcher crops this layer to whatever mask the device
  uses and shifts it under parallax, and a flat charcoal square reads as a dead rectangle when it
  moves. The light is centred just below the middle so it sits behind the aperture, which is what
  makes the foreground look lit rather than merely drawn on top.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="64"
                android:gradientRadius="78">
                <item android:offset="0.0" android:color="#FF1D2836" />
                <item android:offset="0.5" android:color="#FF151A22" />
                <item android:offset="1.0" android:color="#FF0C0D10" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
