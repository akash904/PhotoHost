<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The icon palette is deliberately its own thing, and no longer borrowed from GpicDarkColors.

      The app chrome is dark because you look at photographs against dark; a launcher icon is
      looked at for a quarter of a second among forty others and has to be warm and legible there
      instead. Matching the two made the icon read as a utility rather than as somewhere your
      pictures live, which is the opposite of what it is for.
    -->
    <color name="print_marigold">#FFB648</color>
    <color name="print_coral">#FF7F6B</color>
    <color name="print_edge">#FFFFFF</color>
    <color name="photo_sun">#FFD470</color>
    <color name="photo_hills">#38BC85</color>
</resources>
