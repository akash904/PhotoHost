<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Six blades, six colours, going round the wheel so no two neighbours are close in hue. That is
      the whole reason there are six and not four: adjacent blades have to separate by hue alone at
      launcher size, where the white gaps between them are barely a pixel wide.

      Deliberately not the app's own palette. The chrome is dark because you look at photographs
      against dark; an icon is looked at for a quarter of a second among forty brighter ones.
    -->
    <color name="blade_orange">#FF9F1C</color>
    <color name="blade_yellow">#FFD23F</color>
    <color name="blade_green">#3FBF87</color>
    <color name="blade_blue">#2EA9E0</color>
    <color name="blade_violet">#8E6BE0</color>
    <color name="blade_coral">#FF5E5B</color>
    <!-- The gap between blades, which is what keeps six shapes reading as six. -->
    <color name="blade_gap">#FFFFFF</color>
</resources>
