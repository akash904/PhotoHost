# Build output
/build
/app/build
.gradle/
.kotlin/
/captures
.externalNativeBuild
.cxx
*.apk
*.aab
*.ap_
*.dex

# Machine-specific: points at wherever the Android SDK happens to live.
local.properties

# The Play upload key and its password. Never committed: anything that can sign a build as this
# app belongs on one machine and in a backup, not in history where removing it later does not
# actually remove it.
*.jks
*.keystore
keystore.properties

# IDE
*.iml
.idea/
*.hprof

# Working files from development sessions
/.screenshots/
# Icon/design preview pages. Open in a browser to review artwork; they duplicate what the
# vector drawables already define, so they are reference, not source.
/design/

# OS
.DS_Store
Thumbs.db

# Deliberately NOT ignored:
#   gradle/wrapper/gradle-wrapper.jar  -- without it a fresh clone cannot build
#   app/schemas/                       -- exported Room schemas; migrations are written and
#                                         tested against these, so losing them means losing the
#                                         ability to migrate an existing database safely
